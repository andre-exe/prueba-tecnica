{
  "name": "tok_declined - pago rechazado",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/payments/validate",
    "bodyPatterns": [
      { "equalToJson": "{ \"paymentMethod\": \"tok_declined\" }", "ignoreExtraElements": true }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "approved": false,
      "transactionId": null,
      "reason": "INSUFFICIENT_FUNDS"
    }
  }
}
