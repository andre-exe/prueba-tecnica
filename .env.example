# Copiar a .env para personalizar. Todos los valores tienen un default razonable en docker-compose.yml.

# Base de datos
POSTGRES_DB=coworking
POSTGRES_USER=coworking
POSTGRES_PASSWORD=coworking

# Variables que consume el perfil prod (se usarán en el servicio "app" del compose)
DB_URL=jdbc:postgresql://postgres:5432/coworking
DB_USERNAME=coworking
DB_PASSWORD=coworking
JWT_SECRET=change-me-with-at-least-32-characters-0123456789
PAYMENT_BASE_URL=http://wiremock:8080
ADMIN_EMAIL=admin@coworking.local
ADMIN_PASSWORD=Admin1234!
ADMIN_FULL_NAME=Administrador
