# todo es opcional: docker compose up --build funciona sin este archivo, cada valor tiene un default razonable.
# copialo a .env solo si quieres cambiar algo.

# puertos publicados en tu maquina
APP_PORT=8080
WIREMOCK_PORT=8089

# solo para desarrollo local con docker-compose.dev.yml (cambialo si tu 5432 esta ocupado)
POSTGRES_PORT=5432

# base de datos
POSTGRES_DB=coworking
POSTGRES_USER=coworking
POSTGRES_PASSWORD=coworking

# aplicacion
JWT_SECRET=change-me-with-at-least-32-characters-0123456789
ADMIN_EMAIL=admin@coworking.local
ADMIN_PASSWORD=Admin1234!
ADMIN_FULL_NAME=Administrador
SWAGGER_ENABLED=true
